# fivem-ebpf runtime config. Read by systemd via EnvironmentFile=.
# Values here become CLI flags on the `fivem-ebpf run` invocation.

# Network interface the XDP program attaches to. Find via `ip -br link`.
IFACE=eth0

# FiveM port (TCP + UDP).
PORT=30120

# Whitelist TTL — how long a successfully handshaked IP stays allowed
# without a fresh handshake.
TTL=10m

# Prometheus /metrics listen address.
METRICS_ADDR=:9464

# BPF map pin directory. Survives process restart; cleared on reboot.
PIN_PATH=/sys/fs/bpf/fivem

# cgroup v2 root. Change only for containerized FiveM deployments.
CGROUP_PATH=/sys/fs/cgroup

# Per-IP UDP token bucket (gameplay packet rate).
UDP_RATE=1500
UDP_BURST=4500

# Per-IP POST /client rate limit (handshake attempts per minute + burst).
# Tightened from 10 → 3 after analyzing a real captured attack where 980 IPs
# × 10 burst flooded the server in the first second.
INITCONNECT_PER_MIN=6
INITCONNECT_BURST=3

# Per-IP GET /info.json|/dynamic.json|/players.json rate limit. These
# endpoints return multi-KB JSON (25–50× amplification) and are the primary
# bandwidth-amplification vector — real clients hit them once or twice per
# join, bots hammer them dozens of times per second.
GETINFO_PER_MIN=6
GETINFO_BURST=5

# Global TCP circuit breaker. Caps aggregate packets/sec to the target port
# across all source IPs combined — fires when many-IP attacks slip through
# per-IP limits and the sum saturates the server. Set rate=0 to disable;
# under attack you may want to tighten this to e.g. 1500/4500.
TCP_GLOBAL_RATE=5000
TCP_GLOBAL_BURST=15000

# Per-IP cap on simultaneously-open TCP sockets to the target port. Catches
# connection-hold attacks (bots that complete 3WHS but never speak L7, so
# none of the payload-based filters fire). Real FiveM clients hold ~4-8
# parallel asset-download connections, plus TIME_WAIT residue from prior
# attempts and concurrent /info.json scrapes — 16 is the empirically-derived
# headroom that doesn't kick legit retry-storm players. Whitelisted IPs
# bypass this check entirely (handshake already proves they're real).
# 0 disables.
TCP_MAX_OPEN_PER_IP=16

# UDP health checks. A packet that fails ENet structural validation counts
# as an anomaly; an IP that accumulates HEALTH_THRESHOLD anomalies within
# HEALTH_WINDOW is blacklisted for HEALTH_BLACKLIST.
HEALTH_WINDOW=60s
HEALTH_THRESHOLD=100
HEALTH_BLACKLIST=5m

# How often to refresh the fivem_map_entries Prometheus gauges. Iterating
# 100k-entry LRU maps is expensive, so this is done by a background ticker
# rather than on every /metrics scrape.
MAP_SIZE_INTERVAL=30s
