# systemd reads this file and turns every value into a flag on the run command.
# Change a value rather than deleting a line, because a key that isn't here leaves its flag with nothing after it.

# The network card the filter attaches to.
# Traffic arriving on any other card is not filtered at all, so this has to be the one your players reach you on.
IFACE=eth0

# The port your server listens on, for both tcp and udp.
# Everything else on the card passes straight through.
PORT=30120

# How long a player stays allowed to send udp after the last packet you saw from them.
# Every packet pushes this back, so it only runs out on someone who has gone quiet, and they have to reconnect once it does.
TTL=10m

# Where the metrics and the api listen.
# The api serves the ip of every connected player and has no authentication in front of it.
METRICS_ADDR=127.0.0.1:9464

# Where the filter keeps its state.
# It lives outside the process, so restarting the service keeps everyone connected instead of kicking them.
# The cli reads the same place and takes --pin-path if you move it.
PIN_PATH=/sys/fs/bpf/fivem

# Where the filter hooks into the kernel to hear about finished handshakes.
CGROUP_PATH=/sys/fs/cgroup

# How much gameplay traffic one player may send.
# The rate is packets per second and the burst is how many they can fire off back to back after a quiet moment.
# A real player sits around 60 a second.
UDP_RATE=1500
UDP_BURST=4500

# How often one address may try to join.
# Three attempts back to back covers someone retrying a bad connection, and they earn six more per minute.
INITCONNECT_PER_MIN=6
INITCONNECT_BURST=3

# How often one address may pull the server info pages.
# Those replies are several kilobytes against a tiny request, which is what makes them worth abusing.
GETINFO_PER_MIN=6
GETINFO_BURST=5

# A brake on new connections when things get out of hand.
# It only counts attempts from addresses that are not already playing, so your current players keep reconnecting normally while a flood gets capped.
# Set the rate to 0 to turn it off.
TCP_GLOBAL_RATE=5000
TCP_GLOBAL_BURST=15000

# How many tcp connections one address may hold open at once.
# This is what catches bots that connect and then go silent, because the other checks only ever look at packets that carry something.
# A real client holds four to eight while it downloads assets.
# Set 0 to turn it off.
TCP_MAX_OPEN_PER_IP=16

# Addresses sending udp that does not look like real game traffic get blocked for a while.
# One that racks up HEALTH_THRESHOLD bad packets inside HEALTH_WINDOW is out for HEALTH_BLACKLIST.
HEALTH_WINDOW=60s
HEALTH_THRESHOLD=100
HEALTH_BLACKLIST=5m

# How often the tracked address counts get recounted for your dashboard.
# Counting means walking a map that holds up to a hundred thousand entries, so it runs on a timer rather than on every scrape.
# Set it to 0 to stop counting and everything else keeps working.
MAP_SIZE_INTERVAL=30s

# Remembers why each ip was dropped.
# Having a reason why an ip was blocked gives you debugging info for when a legitimate player tried to join but couldn't.
# Turning this on has no real performance impact.
DROP_HISTORY=true
