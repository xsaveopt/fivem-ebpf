[Unit]
Description=FiveM XDP DDoS filter
Documentation=https://github.com/sratabix/fivem-ebpf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/fivem-ebpf/config
ExecStart=/usr/local/bin/fivem-ebpf run \
  --iface ${IFACE} \
  --port ${PORT} \
  --ttl ${TTL} \
  --metrics-addr ${METRICS_ADDR} \
  --pin-path ${PIN_PATH} \
  --cgroup ${CGROUP_PATH} \
  --udp-rate ${UDP_RATE} \
  --udp-burst ${UDP_BURST} \
  --tcp-initconnect-per-min ${INITCONNECT_PER_MIN} \
  --tcp-initconnect-burst ${INITCONNECT_BURST} \
  --tcp-getinfo-per-min ${GETINFO_PER_MIN} \
  --tcp-getinfo-burst ${GETINFO_BURST} \
  --tcp-global-rate ${TCP_GLOBAL_RATE} \
  --tcp-global-burst ${TCP_GLOBAL_BURST} \
  --tcp-max-open-per-ip ${TCP_MAX_OPEN_PER_IP} \
  --health-window ${HEALTH_WINDOW} \
  --health-threshold ${HEALTH_THRESHOLD} \
  --health-blacklist ${HEALTH_BLACKLIST} \
  --map-size-interval ${MAP_SIZE_INTERVAL}

Restart=on-failure
RestartSec=5s

User=root
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON
NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/sys/fs/bpf
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=no
PrivateTmp=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
