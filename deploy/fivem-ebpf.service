[Unit]
Description=FiveM XDP DDoS filter
Documentation=https://github.com/xsaveopt/fivem-ebpf
After=network-online.target sys-fs-bpf.mount
Wants=network-online.target
RequiresMountsFor=/sys/fs/bpf

[Service]
Type=simple
EnvironmentFile=/etc/fivem-ebpf/config
ExecStart=/usr/local/bin/fivem-ebpf run \
  --iface=${IFACE} \
  --port=${PORT} \
  --ttl=${TTL} \
  --metrics-addr=${METRICS_ADDR} \
  --pin-path=${PIN_PATH} \
  --cgroup=${CGROUP_PATH} \
  --udp-rate=${UDP_RATE} \
  --udp-burst=${UDP_BURST} \
  --tcp-initconnect-per-min=${INITCONNECT_PER_MIN} \
  --tcp-initconnect-burst=${INITCONNECT_BURST} \
  --tcp-getinfo-per-min=${GETINFO_PER_MIN} \
  --tcp-getinfo-burst=${GETINFO_BURST} \
  --tcp-global-rate=${TCP_GLOBAL_RATE} \
  --tcp-global-burst=${TCP_GLOBAL_BURST} \
  --tcp-max-open-per-ip=${TCP_MAX_OPEN_PER_IP} \
  --health-window=${HEALTH_WINDOW} \
  --health-threshold=${HEALTH_THRESHOLD} \
  --health-blacklist=${HEALTH_BLACKLIST} \
  --map-size-interval=${MAP_SIZE_INTERVAL} \
  --drop-history=${DROP_HISTORY}

Restart=always
RestartSec=5s

User=root
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
NoNewPrivileges=true
LimitMEMLOCK=infinity

ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
ProtectHostname=yes
ProtectClock=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service @bpf
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
