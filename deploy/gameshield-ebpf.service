[Unit]
Description=gameshield-ebpf modular game-server DDoS filter
Documentation=https://github.com/sratabix/gameshield-ebpf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gameshield run --config /etc/gameshield/config.yaml

Restart=on-failure
RestartSec=5s

User=root
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON
NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/sys/fs/bpf
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=no
PrivateTmp=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
