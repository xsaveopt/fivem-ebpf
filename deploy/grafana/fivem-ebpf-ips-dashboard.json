  "description": "Per-IP listings: who's whitelisted, who's blacklisted, who's holding open TCP. Live snapshots over the daemon's /api/* endpoints. Requires the Infinity datasource (yesoreyeram-infinity-datasource).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Whitelist (tcp_whitelist)",
      "description": "IPs allowed to send UDP. age_seconds is time since the last packet refreshed the entry; anything older than TTL is dropped as expired on its next packet.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/api/whitelist",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "ip",
              "text": "IP",
              "type": "string"
            },
            {
              "selector": "age_seconds",
              "text": "Age (s)",
              "type": "number"
            }
          ],
          "filters": [],
          "global_query_id": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Age (s)",
            "desc": false
          }
        ]
      }
    },
